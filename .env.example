# Azure AD Gruppen (Object-IDs aus dem Azure Portal)
GROUP_ETIM_ID=151749ec-646a-4ff1-8121-55a4f66cd30b
GROUP_GS1_ID=7d48f1af-2ccb-44b1-bc5c-e5d99045dd93

# Ziel-URLs für den POST-Request
TARGET_URL_ETIM=https://edi.eglo.com/dw/Request/ETIM10_Export/v1
TARGET_URL_GS1=https://edi.eglo.com/dw/Request/GS1_Export/v1

# Basic Auth Zugangsdaten (leer lassen wenn nicht benötigt)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Request Timeout in Sekunden
REQUEST_TIMEOUT=30

# Maximale Upload-Größe in MB
MAX_UPLOAD_SIZE_MB=25

# GS1-XML-Export: PostgreSQL-Verbindung (PIM-Datenbank)
PGHOST=lobster.eglo.com
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# GS1-XML-Export: Pfad zur Root-/Envelope-XSD des GDSN-Schema-Pakets (CatalogueItemNotification.xsd)
GS1_XSD_ROOT=

# GS1-XML-Export: Absender/Empfaenger (SBDH + brandOwner/informationProviderOfTradeItem)
GS1_SENDER_GLN=
GS1_SENDER_PARTY_NAME=EGLO
GS1_RECEIVER_GLN=
GS1_ADDITIONAL_CLASSIFICATION_SYSTEM_CODE=64

# GS1-XML-Export: SAP-HANA-Verbindung (fuer Daten, die nicht im PIM stehen -
# Lieferbedingungen, Zoll/Herkunftsland, Steuerdaten etc.)
HANA_HOST=lasappeg001
HANA_PORT=30244
HANA_DBNAME=SAPABAP1
HANA_SCHEMA=SAPABAP1
HANA_USER=HANAREAD
HANA_PASSWORD=